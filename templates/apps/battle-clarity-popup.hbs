{{!-- battle-clarity-popup.hbs  -  Priority Target core action target picker --}}
<div class="shipcombat-tp-wrapper">

    {{#if noTargets}}
    <div class="shipcombat-tp-empty">
        <i class="fa-solid fa-ban"></i>
        {{localize "SHIPCOMBAT.Captain.Core.BCNoTargets"}}
    </div>
    {{else}}
    <div class="shipcombat-tp-targets">
        {{#each targets}}
        <div class="shipcombat-tp-target {{#if this.isRecommended}}shipcombat-tp-target--recommended{{/if}} {{#if this.isPriority}}shipcombat-tp-target--priority{{/if}}">
            <img src="{{this.img}}" class="shipcombat-tp-target-icon">
            <div class="shipcombat-tp-target-info">
                <span class="shipcombat-tp-target-name">{{this.name}}</span>
                {{#if this.isRecommended}}<span class="shipcombat-tp-target-marker shipcombat-tp-target-marker--recommended" style="color:{{../markerPalette.recommended}}"><i class="fa-solid fa-crosshairs"></i> {{localize "SHIPCOMBAT.Sensors.RecommendationLabel"}}</span>{{/if}}
                {{#if this.isPriority}}<span class="shipcombat-tp-target-marker shipcombat-tp-target-marker--priority" style="color:{{../markerPalette.priority}}"><i class="fa-solid fa-crosshairs"></i> {{localize "SHIPCOMBAT.Sensors.BattleClarityLabel"}}</span>{{/if}}
            </div>
            <div class="shipcombat-tp-target-stats">
                <div class="shipcombat-tp-lock-badge" style="color:{{this.lockColour}};border-color:{{this.lockColour}}">
                    {{this.lockLabel}}
                </div>
            </div>
            <button type="button" class="shipcombat-tp-fire-btn" data-action="confirmDesignate" data-token-id="{{this.tokenId}}"
                    data-tooltip="{{localize "SHIPCOMBAT.Captain.Core.BCDesignate"}}">
                <i class="fa-solid fa-crosshairs"></i>
            </button>
        </div>
        {{/each}}
    </div>
    {{/if}}

</div>
